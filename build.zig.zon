.{
    .name = .deed,
    .version = "0.1.0",
    .fingerprint = 0x89498c2094a1a4a3,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Path dependency while `deed` and the library move together. Becomes a
        // pinned URL + hash at the first tagged release, like every other
        // consumer in the org.
        .nostr = .{ .path = "../nostr" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
