.{
    .name = .deed,
    .version = "0.4.1",
    .fingerprint = 0x89498c2094a1a4a3,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The protocol library, pinned by URL and hash the way every other
        // consumer in the org pins it. A tag rather than a branch: what deed
        // builds against has to be something anybody can fetch and check for
        // themselves later, and "whatever main happened to be that afternoon"
        // is not that.
        .nostr = .{
            .path = "../nostr-int",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
